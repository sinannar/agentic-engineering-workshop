---
interface LessonSummary {
  id: string;
  data: {
    order: number;
    title: string;
    feature: string;
    estimatedMinutes?: number;
    workflow: 'setup' | 'rpi';
  };
}

interface Props {
  lessons: LessonSummary[];
  currentId: string;
}

const { lessons, currentId } = Astro.props;
---

<aside class="lesson-sidebar" aria-label="Workshop lessons">
  <div class="lesson-sidebar-heading">
    <p class="eyebrow">Workshop path</p>
    <span class="mono">{lessons.length - 1} feature steps</span>
  </div>
  <nav class="lesson-steps">
    {lessons.map((lesson) => (
      <a
        class:list={{ 'lesson-step': true, 'is-current': lesson.id === currentId }}
        href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/lessons/${lesson.id}/`}
        aria-current={lesson.id === currentId ? 'page' : undefined}
        data-lesson-step={lesson.id}
      >
        <span class="lesson-step-number">{String(lesson.data.order).padStart(2, '0')}</span>
        <span class="lesson-step-copy">
          <strong>{lesson.data.workflow === 'setup' ? 'Setup' : lesson.data.feature}</strong>
          {lesson.data.estimatedMinutes && <small>{lesson.data.estimatedMinutes} min</small>}
        </span>
      </a>
    ))}
  </nav>
</aside>
