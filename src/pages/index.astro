---
import { getCollection } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';

const lessons = (await getCollection('lessons')).sort((a, b) => a.data.order - b.data.order);
const firstLesson = lessons[0];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<SiteLayout
  title="Agentic Engineering Workshop"
  description="Build SupportHub, a distributed customer support application, using Aspire, GitHub Copilot CLI, and HVE Core across seven feature steps."
>
  <article class="container workshop-intro">
    <h1>Agentic Engineering Workshop</h1>
    <p>
      Build <strong>SupportHub</strong>, a distributed customer support and ticket
      management application, using .NET 10, Aspire, GitHub Copilot CLI, HVE Core,
      RPI workflows, and stacked pull requests.
    </p>
    <p>
      Follow the setup guide, then work through seven feature steps covering
      customers, tickets, attachments, activity, SLAs, dashboards, and UI/UX.
      Each step uses a Research–Plan–Implement–Review cycle.
    </p>

    <section aria-label="Start the workshop">
      <a class="button" href={`${base}/lessons/${firstLesson.id}/`}>
        Start workshop
      </a>
    </section>
  </article>
</SiteLayout>

<style>
  .workshop-intro {
    max-width: 760px;
    padding-block: clamp(2.5rem, 7vw, 5rem);
  }

  h1 {
    margin: 0 0 1.5rem;
    font-size: clamp(2rem, 5vw, 3rem);
    line-height: 1.15;
    letter-spacing: -0.04em;
  }

  p,
  li {
    color: var(--ink-soft);
    font-size: 1.05rem;
  }

  strong {
    color: var(--ink);
  }

  section {
    margin-top: 2rem;
  }

</style>
