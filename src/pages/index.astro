---
import { getCollection } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';

const lessons = (await getCollection('lessons')).sort((a, b) => a.data.order - b.data.order);
const setupLesson = lessons.find((lesson) => lesson.data.workflow === 'setup') ?? lessons[0];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const finalWorkshopUrl = 'https://github.com/sinannar/agenticengineeringday2026-experiment/tree/devcontainer';
const templateUrl = 'https://github.com/sinannar/agenticengineeringday2026-template';
const websiteRepoUrl = 'https://github.com/sinannar/agenticengineeringday2026-workshop';

const workflow = [
  {
    number: '01',
    title: 'Research',
    description: 'Understand the problem before changing code. Explore requirements, investigate the existing application, identify constraints, and gather evidence to guide implementation.',
  },
  {
    number: '02',
    title: 'Plan',
    description: 'Turn research into an actionable engineering plan. Define the approach, break work into manageable tasks, identify dependencies, and establish acceptance criteria.',
  },
  {
    number: '03',
    title: 'Implement',
    description: 'Collaborate with AI agents to execute the plan. Make focused changes, run the application, write tests, and validate the results.',
  },
  {
    number: '04',
    title: 'Review',
    description: 'Evaluate the implementation before delivery. Inspect changes for correctness, maintainability, security, and alignment with the original requirements.',
  },
];

const toolkit = [
  ['GitHub Copilot CLI', 'Collaborate with coding agents directly from the terminal.'],
  ['HVE Core', 'Apply structured research, planning, implementation, and review workflows.'],
  ['Agent Skills', 'Extend agents with reusable engineering capabilities and instructions.'],
  ['.NET 10', 'Build modern APIs, services, and background workers.'],
  ['Aspire', 'Develop, orchestrate, and observe distributed applications.'],
  ['Blazor', 'Build an interactive application experience.'],
  ['GitHub CLI & gh-stack', 'Deliver dependent changes through stacked pull requests.'],
  ['Dev Containers & Codespaces', 'Work in a reproducible development environment.'],
];
---

<SiteLayout
  title="Agentic Engineering Workshop"
  description="Learn disciplined, agentic software engineering by building SupportHub with AI coding agents, .NET 10, Aspire, and Blazor."
>
  <section class="container hero">
    <div>
      <p class="eyebrow">Hands-on workshop / 2026</p>
      <h1>From prompts to <span>practice.</span></h1>
      <p class="hero-lede">
        Learn how to collaborate with AI coding agents to research, plan, implement,
        test, and review real software using structured engineering practices and
        modern development tools.
      </p>
      <div class="hero-actions">
        <a class="button" href={`${base}/chapters/${setupLesson.id}/`}>Start workshop <span aria-hidden="true">↗</span></a>
        <a class="button secondary" href="#workshop">Explore the workshop</a>
        <a class="button secondary" href={`${base}/references/`}>References</a>
      </div>
      <div class="hero-stats" aria-label="Workshop overview">
        <span><strong>7</strong> features</span>
        <span><strong>4</strong> RPI phases</span>
        <span><strong>1</strong> application</span>
      </div>
      <div class="repo-links" aria-label="Workshop repositories">
        <a href={templateUrl}>Start from the Aspire template <span aria-hidden="true">↗</span></a>
        <a href={finalWorkshopUrl}>See the final workshop <span aria-hidden="true">↗</span></a>
      </div>
    </div>

    <div class="hero-art" aria-label="Research, plan, implement, review workflow illustration">
      <span class="orbit-label orbit-label-top mono">development / lifecycle</span>
      <span class="orbit-label orbit-label-bottom mono">ship with confidence</span>
      <span class="signal one" aria-hidden="true"></span>
      <span class="signal two" aria-hidden="true"></span>
      <div class="terminal">
        <div class="terminal-bar" aria-hidden="true"><i></i><i></i><i></i></div>
        <div class="terminal-line"><strong>$</strong> copilot</div>
        <div class="terminal-line">research the next feature</div>
        <div class="terminal-line">→ evidence collected</div>
        <div class="terminal-line">→ plan ready</div>
        <div class="terminal-line">→ tests passing</div>
      </div>
    </div>
  </section>

  <section class="container lifecycle-section" aria-labelledby="intro-title">
    <div class="lifecycle-intro intro-band">
      <div class="intro-copy">
        <p class="eyebrow">Beyond vibe coding</p>
        <h2 id="intro-title">Better software needs more than generated code.</h2>
      </div>
      <div class="prep-grid">
        <p>
          AI can generate code in seconds. Engineering reliable software requires more:
          clear requirements, deliberate planning, incremental implementation, automated
          validation, and thoughtful review.
        </p>
        <p>
          In this workshop, AI agents become collaborators throughout the software delivery
          lifecycle. The goal is not to generate more code. It is to deliver better software
          with greater confidence.
        </p>
      </div>
    </div>
    <div class="lifecycle-method">
      <div class="section-heading">
        <div>
          <p class="eyebrow">The engineering workflow</p>
          <h2>A repeatable process for every feature.</h2>
        </div>
        <p>Powered by HVE Core's Research–Plan–Implement–Review methodology.</p>
      </div>
      <div class="method-grid">
        {workflow.map((step) => (
          <article class="method-step">
            <span class="method-index">{step.number}</span>
            <div>
              <h3>{step.title}</h3>
              <p>{step.description}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="workshop" class="container section" aria-labelledby="build-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Technology &amp; tools</p>
        <h2 id="build-title">The stack for modern agentic development.</h2>
      </div>
      <p>SupportHub is the example application. The focus is learning how the application stack and engineering tools work together in a real system.</p>
    </div>
    <ul class="technology-list">
      <li>
        <span class="technology-bullet" aria-hidden="true">↗</span>
        <div><strong>.NET 10</strong><span>Build two ASP.NET Core APIs and background services.</span></div>
      </li>
      <li>
        <span class="technology-bullet" aria-hidden="true">↗</span>
        <div><strong>Aspire</strong><span>Orchestrate, run, and observe the distributed application locally.</span></div>
      </li>
      <li>
        <span class="technology-bullet" aria-hidden="true">↗</span>
        <div><strong>Blazor</strong><span>Build the interactive frontend that connects the support workflows.</span></div>
      </li>
      <li>
        <span class="technology-bullet" aria-hidden="true">↗</span>
        <div><strong>PostgreSQL &amp; Redis</strong><span>Persist application data and add deliberate caching and resilience.</span></div>
      </li>
      <li>
        <span class="technology-bullet" aria-hidden="true">↗</span>
        <div><strong>Azure Storage</strong><span>Handle file attachments with Blob Storage and Azurite locally.</span></div>
      </li>
      <li>
        <span class="technology-bullet" aria-hidden="true">↗</span>
        <div><strong>Messaging &amp; workers</strong><span>Process background activity with Service Bus, Cosmos DB, and scheduled services.</span></div>
      </li>
      {toolkit
        .filter(([title]) => !['.NET 10', 'Aspire', 'Blazor'].includes(title))
        .map(([title, description]) => (
          <li>
            <span class="technology-bullet" aria-hidden="true">↗</span>
            <div><strong>{title}</strong><span>{description}</span></div>
          </li>
        ))}
    </ul>
  </section>

  <section class="container section learn-section" aria-labelledby="learn-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">What you'll learn</p>
        <h2 id="learn-title">Engineer with agents, deliberately.</h2>
      </div>
    </div>
    <ul class="learning-list">
      <li>Apply the agentic development lifecycle to real engineering tasks.</li>
      <li>Use GitHub Copilot CLI and HVE Core throughout the development lifecycle.</li>
      <li>Research unfamiliar codebases and plan changes before implementation.</li>
      <li>Build and run distributed .NET applications with Aspire.</li>
      <li>Use agent instructions and skills to improve coding-agent effectiveness.</li>
      <li>Implement and validate features incrementally.</li>
      <li>Manage dependent changes using stacked pull requests.</li>
      <li>Review AI-generated code with the same rigor as human-written code.</li>
    </ul>
  </section>

  <section class="container repository-footer" aria-labelledby="repositories-title">
    <div>
      <p class="eyebrow">Explore the code</p>
      <h2 id="repositories-title">Three repositories. One learning journey.</h2>
    </div>
    <nav aria-label="Workshop repositories">
      <div class="repository-card template-card">
        <a class="repository-link" href={templateUrl}><strong>Template</strong><span>Start with Aspire</span><span aria-hidden="true">↗</span></a>
        <button class="qr-trigger" type="button" data-qr-src={`${base}/images/repository-template-qr.png`} data-qr-title="Aspire template repository" data-qr-alt="QR code for the Aspire template repository">Show QR code</button>
      </div>
      <div class="repository-card">
        <a class="repository-link" href={finalWorkshopUrl}><strong>Final workshop</strong><span>See the completed build</span><span aria-hidden="true">↗</span></a>
        <button class="qr-trigger" type="button" data-qr-src={`${base}/images/repository-final-workshop-qr.png`} data-qr-title="Completed workshop repository" data-qr-alt="QR code for the completed workshop repository">Show QR code</button>
      </div>
      <div class="repository-card">
        <a class="repository-link" href={websiteRepoUrl}><strong>Astro / GitHub Pages</strong><span>Explore the Astro source for this site</span><span aria-hidden="true">↗</span></a>
        <button class="qr-trigger" type="button" data-qr-src={`${base}/images/repository-website-qr.png`} data-qr-title="Workshop website repository" data-qr-alt="QR code for the workshop website repository">Show QR code</button>
      </div>
    </nav>
  </section>

  <section class="container bottom-cta" aria-label="Start the workshop">
    <a class="button" href={`${base}/chapters/${setupLesson.id}/`}>Start workshop <span aria-hidden="true">↗</span></a>
  </section>

  <dialog class="qr-dialog" data-qr-dialog aria-labelledby="qr-dialog-title">
    <div class="qr-dialog-card">
      <div class="qr-dialog-heading">
        <div>
          <p class="eyebrow">Scan to open</p>
          <h2 id="qr-dialog-title" data-qr-dialog-title>Repository</h2>
        </div>
        <button class="qr-dialog-close" type="button" data-qr-close aria-label="Close QR code">×</button>
      </div>
      <img data-qr-dialog-image src="" alt="" />
    </div>
  </dialog>
</SiteLayout>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-qr-dialog]');
  const dialogTitle = document.querySelector<HTMLElement>('[data-qr-dialog-title]');
  const dialogImage = document.querySelector<HTMLImageElement>('[data-qr-dialog-image]');
  const closeButton = document.querySelector<HTMLButtonElement>('[data-qr-close]');

  document.querySelectorAll<HTMLButtonElement>('[data-qr-src]').forEach((trigger) => {
    trigger.addEventListener('click', (event) => {
      event.preventDefault();
      event.stopPropagation();
      if (!dialog || !dialogTitle || !dialogImage) return;
      dialogTitle.textContent = trigger.dataset.qrTitle ?? 'Repository';
      dialogImage.src = trigger.dataset.qrSrc ?? '';
      dialogImage.alt = trigger.dataset.qrAlt ?? '';
      dialog.showModal();
    });
  });

  closeButton?.addEventListener('click', () => dialog?.close());
  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) dialog.close();
  });
</script>

<style>
  .hero {
    min-height: min(700px, calc(100vh - 5.25rem));
  }

  .lifecycle-section {
    padding-block: clamp(4rem, 8vw, 7rem);
  }

  .lifecycle-method {
    padding-top: clamp(3rem, 6vw, 5rem);
  }

  .text-link {
    font-size: 0.92rem;
  }

  .lifecycle-track {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
    border-block: 1px solid var(--line);
  }

  .lifecycle-track li {
    display: grid;
    gap: 0.45rem;
    padding: 1rem 1rem 1rem 0;
    border-right: 1px solid var(--line);
  }

  .lifecycle-track li:not(:first-child) {
    padding-left: 1rem;
  }

  .lifecycle-track li:last-child {
    border-right: 0;
  }

  .lifecycle-track span {
    color: var(--accent-strong);
    font: 0.68rem var(--font-mono);
  }

  .lifecycle-track strong {
    font-size: 1rem;
  }

  .technology-list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }

  .technology-list li {
    display: grid;
    grid-template-columns: 1.7rem 1fr;
    gap: 0.8rem;
    align-items: start;
    padding: 1.35rem 1.5rem 1.35rem 0;
    border-bottom: 1px solid var(--line);
  }

  .technology-bullet {
    display: grid;
    width: 1.55rem;
    height: 1.55rem;
    place-items: center;
    border: 1px solid var(--accent);
    border-radius: 50%;
    color: var(--accent);
    font: 0.7rem var(--font-mono);
  }

  .technology-list div {
    display: grid;
    gap: 0.25rem;
  }

  .technology-list strong {
    font-size: 1.08rem;
  }

  .technology-list div span {
    color: var(--ink-soft);
    font-size: 0.92rem;
  }

  .repo-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.5rem;
    margin-top: 1.6rem;
    font: 0.72rem var(--font-mono);
  }

  .repo-links a {
    color: var(--accent-strong);
    text-decoration: none;
  }

  .repo-links a:hover {
    color: var(--ink);
  }

  .learning-list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }

  .learning-list li {
    padding: 1.15rem 1rem 1.15rem 0;
    border-bottom: 1px solid var(--line);
    color: var(--ink-soft);
  }

  .learning-list li::before {
    margin-right: 0.65rem;
    color: var(--accent);
    content: '↗';
    font-family: var(--font-mono);
  }

  .text-link {
    display: inline-flex;
    gap: 0.45rem;
    margin-top: 1.5rem;
    color: var(--accent-strong);
    font-weight: 600;
    text-decoration: none;
  }

  .text-link:hover {
    color: var(--ink);
  }

  .repository-footer {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: 2rem;
    padding-block: 2rem 4rem;
    border-top: 1px solid var(--line);
  }

  .bottom-cta {
    display: flex;
    justify-content: center;
    padding-block: 0 clamp(4rem, 8vw, 7rem);
  }

  .repository-footer h2 {
    max-width: 380px;
    margin: 0;
    font-size: clamp(1.7rem, 3vw, 2.4rem);
    letter-spacing: -0.055em;
    line-height: 1;
  }

  .repository-footer nav {
    display: grid;
    min-width: min(100%, 500px);
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--line);
  }

  .repository-card {
    display: grid;
    grid-template-rows: 1fr auto;
    gap: 0.3rem;
    align-content: start;
    padding: 1rem 1rem 0 0;
    border-right: 1px solid var(--line);
  }

  .repository-card:not(:first-child) {
    padding-left: 1rem;
  }

  .repository-card:last-child {
    border-right: 0;
  }

  .repository-link {
    display: grid;
    grid-template-rows: auto 1fr auto;
    min-height: 5.1rem;
    gap: 0.3rem;
    color: var(--accent-strong);
    text-decoration: none;
  }

  .qr-trigger {
    justify-self: start;
    width: 100%;
    min-height: 2.5rem;
    margin-top: 0.7rem;
    padding: 0.55rem 0.8rem;
    border: 1px solid var(--ink);
    border-radius: 0.45rem;
    background: var(--surface);
    color: var(--ink);
    cursor: pointer;
    font: 600 0.78rem var(--font-sans);
    letter-spacing: 0.01em;
    text-align: center;
  }

  .qr-trigger:hover {
    border-color: var(--accent);
    background: var(--ink);
    color: var(--canvas);
  }

  .qr-dialog {
    width: min(90vw, 34rem);
    padding: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--surface-raised);
    color: var(--ink);
    box-shadow: 0 2rem 6rem rgb(0 0 0 / 28%);
  }

  .qr-dialog::backdrop {
    background: rgb(12 18 25 / 72%);
    backdrop-filter: blur(0.25rem);
  }

  .qr-dialog-card {
    display: grid;
    gap: 1.5rem;
    padding: clamp(1.25rem, 4vw, 2rem);
  }

  .qr-dialog-heading {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: 1rem;
  }

  .qr-dialog-heading h2 {
    margin: 0.25rem 0 0;
    font-size: clamp(1.4rem, 3vw, 2rem);
  }

  .qr-dialog-close {
    width: 2rem;
    height: 2rem;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: transparent;
    color: var(--ink);
    cursor: pointer;
    font-size: 1.25rem;
    line-height: 1;
  }

  .qr-dialog-close:hover {
    border-color: var(--accent);
    color: var(--accent-strong);
  }

  .qr-dialog img {
    width: min(100%, 25rem);
    justify-self: center;
    aspect-ratio: 1;
    border-radius: 0.75rem;
    background: #fff;
  }

  .repository-link:hover {
    color: var(--ink);
  }

  .repository-link span:nth-child(2) {
    color: var(--ink-soft);
    font-size: 0.82rem;
  }

  @media (max-width: 780px) {
    .lifecycle-track {
      grid-template-columns: repeat(2, 1fr);
    }

    .lifecycle-track li:nth-child(2) {
      border-right: 0;
    }

    .lifecycle-track li:nth-child(3),
    .lifecycle-track li:nth-child(4) {
      border-top: 1px solid var(--line);
    }

    .lifecycle-track li:nth-child(3) {
      padding-left: 0;
    }

    .technology-list {
      grid-template-columns: 1fr;
    }

    .learning-list {
      grid-template-columns: 1fr;
    }

    .repository-footer {
      flex-direction: column;
    }

    .repository-footer nav {
      width: 100%;
    }
  }

  @media (max-width: 520px) {
    .lifecycle-track {
      grid-template-columns: 1fr;
    }

    .lifecycle-track li,
    .lifecycle-track li:not(:first-child) {
      padding-inline: 0;
      border-right: 0;
      border-top: 1px solid var(--line);
    }

    .lifecycle-track li:first-child {
      border-top: 0;
    }

    .repository-footer nav {
      grid-template-columns: 1fr;
    }

    .repository-footer a,
    .repository-footer a:not(:first-child) {
      padding-inline: 0;
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }
  }
</style>
