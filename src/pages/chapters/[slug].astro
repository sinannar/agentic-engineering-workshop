---
import { getCollection, render } from 'astro:content';
import LessonPager from '../../components/LessonPager.astro';
import LessonPhaseNav from '../../components/LessonPhaseNav.astro';
import LessonSidebar from '../../components/LessonSidebar.astro';
import SetupGuide from '../../components/SetupGuide.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';

export async function getStaticPaths() {
  const lessons = (await getCollection('lessons')).sort((a, b) => a.data.order - b.data.order);
  return lessons.map((lesson, index) => ({
    params: { slug: lesson.id },
    props: {
      lesson,
      previous: lessons[index - 1],
      next: lessons[index + 1],
      lessons,
    },
  }));
}

const { lesson, previous, next } = Astro.props;
const lessons = (await getCollection('lessons')).sort((a, b) => a.data.order - b.data.order);
const { Content } = await render(lesson);
const description = lesson.data.summary;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<SiteLayout title={`${lesson.data.title} — Agentic Engineering Workshop`} description={description}>
  <div
    class="lesson-shell container"
    data-lesson={lesson.id}
    data-lesson-order={lesson.data.order}
    data-progress-key={`lesson:${lesson.id}`}
  >
    <LessonSidebar lessons={lessons} currentId={lesson.id} />
    <article class="lesson-article">
      <header class="lesson-header">
        <div class="lesson-kicker">
          <span class="eyebrow">{lesson.data.workflow === 'setup' ? 'Step 0 / Preparation' : `Step ${String(lesson.data.order).padStart(2, '0')}`}</span>
          <span class="lesson-status" data-lesson-status={lesson.data.status}>{lesson.data.status}</span>
        </div>
        <h1>{lesson.data.title}</h1>
        <p class="lesson-summary">{lesson.data.summary}</p>
        <div class="lesson-meta" aria-label="Lesson details">
          <span class="mono">{lesson.data.feature}</span>
          {lesson.data.estimatedMinutes && (
            <>
              <span aria-hidden="true">·</span>
              <span>{lesson.data.estimatedMinutes} minutes</span>
            </>
          )}
        </div>
      </header>

      {lesson.data.workflow === 'rpi' && <LessonPhaseNav />}

      {lesson.data.workflow === 'setup' ? <SetupGuide /> : (
        <div class="lesson-content" data-lesson-content>
          <Content />
        </div>
      )}

      {lesson.data.workflow === 'rpi' && (
        <div class="workflow-controls" data-workflow-controls hidden>
          <button class="button secondary" type="button" data-mark-lesson-complete>Mark chapter complete</button>
          <button class="button secondary" type="button" data-reset-progress>Reset saved progress</button>
          <span class="workflow-status" data-workflow-status role="status" aria-live="polite"></span>
        </div>
      )}

      {lesson.data.workflow === 'rpi' && (
        <section class="next-step" data-follow-up-cycle hidden aria-live="polite">
          <div>
            <p class="eyebrow">Review complete</p>
            <p class="next-step-message">Review triggered another cycle.</p>
          </div>
          {next ? (
            <a class="button" href={`${base}/chapters/${next.id}/`}>Go to next chapter <span aria-hidden="true">↗</span></a>
          ) : (
            <span class="next-step-message">Workshop complete.</span>
          )}
        </section>
      )}

      <LessonPager previous={previous} next={next} />
    </article>
  </div>
</SiteLayout>

<script>
  import {
    PHASES,
    readProgress,
    resetProgress,
    updateProgress,
  } from '../../scripts/progress';

  const shell = document.querySelector('[data-lesson]');
  const lessonId = shell?.getAttribute('data-lesson');
  const phaseNav = document.querySelector('[data-phase-navigation]');
  const workflowControls = document.querySelector('[data-workflow-controls]');
  const status = document.querySelector('[data-workflow-status]');
  const followUp = document.querySelector('[data-follow-up-cycle]');
  const markLessonButton = document.querySelector('[data-mark-lesson-complete]');
  const resetButton = document.querySelector('[data-workflow-controls] [data-reset-progress]');

  document.querySelectorAll<HTMLPreElement>('.lesson-article pre').forEach((pre) => {
    const code = pre.querySelector('code');
    if (!code) return;

    const isTerminal = ['language-bash', 'language-shell', 'language-sh', 'language-powershell'].some((language) =>
      code.classList.contains(language),
    );
    if (isTerminal) pre.classList.add('terminal-code');

    const copyButton = document.createElement('button');
    copyButton.className = isTerminal ? 'prompt-copy terminal-copy' : 'prompt-copy';
    copyButton.type = 'button';
    const copyLabel = isTerminal ? 'Copy command' : 'Copy prompt';
    copyButton.textContent = copyLabel;
    copyButton.setAttribute('aria-live', 'polite');
    copyButton.setAttribute('aria-label', `${copyLabel} to clipboard`);
    copyButton.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(code.textContent?.trim() ?? '');
        copyButton.textContent = 'Copied';
        copyButton.setAttribute('aria-label', `${copyLabel} copied to clipboard`);
      } catch {
        copyButton.textContent = 'Copy failed';
        copyButton.setAttribute('aria-label', `Copy failed; select the ${isTerminal ? 'command' : 'prompt'} text manually`);
      }
      window.setTimeout(() => {
        copyButton.textContent = copyLabel;
        copyButton.setAttribute('aria-label', `${copyLabel} to clipboard`);
      }, 2200);
    });
    pre.append(copyButton);
  });

  if (shell && lessonId) {
    const setStatus = (message: string) => status?.replaceChildren(message);
    const getLesson = () => readProgress().lessons[lessonId] ?? {
      primaryPhase: 'research',
      completedPhases: [],
    };

    const render = () => {
      const progress = readProgress();
      const lesson = getLesson();
      const complete = progress.completedLessons.includes(lessonId);

      workflowControls?.removeAttribute('hidden');
      phaseNav?.querySelectorAll<HTMLButtonElement>('[data-phase-complete]').forEach((button) => {
        const phase = button.dataset.phaseComplete;
        if (!phase) return;
        const isComplete = lesson.completedPhases.includes(phase as typeof PHASES[number]);
        button.hidden = false;
        button.setAttribute('aria-pressed', String(isComplete));
        button.textContent = isComplete ? 'Completed' : 'Mark complete';
      });
      if (markLessonButton instanceof HTMLButtonElement) {
        markLessonButton.textContent = complete ? 'Chapter complete' : 'Mark chapter complete';
        markLessonButton.setAttribute('aria-pressed', String(complete));
      }
      if (followUp instanceof HTMLElement) followUp.hidden = !complete;
    };

    const completePhase = (phase: typeof PHASES[number]) => {
      updateProgress((progress) => {
        const lesson = getLesson();
        const completedPhases = Array.from(new Set([...lesson.completedPhases, phase]))
          .filter((item): item is typeof PHASES[number] => PHASES.includes(item as typeof PHASES[number]));
        const nextPhase = PHASES.find((item) => !completedPhases.includes(item)) ?? 'review';
        return {
          ...progress,
          primaryPhase: nextPhase,
          lessons: {
            ...progress.lessons,
            [lessonId]: { primaryPhase: nextPhase, completedPhases },
          },
          completedLessons: completedPhases.length === PHASES.length
            ? Array.from(new Set([...progress.completedLessons, lessonId]))
            : progress.completedLessons.filter((id) => id !== lessonId),
        };
      });
      setStatus(`${phase[0].toUpperCase()}${phase.slice(1)} marked complete.`);
      render();
    };

    phaseNav?.querySelectorAll<HTMLAnchorElement>('[data-phase]').forEach((link) => {
      link.addEventListener('click', () => {
        const phase = link.dataset.phase;
        if (!phase || !PHASES.includes(phase as typeof PHASES[number])) return;
        updateProgress((progress) => ({
          ...progress,
          primaryPhase: phase as typeof PHASES[number],
          lessons: {
            ...progress.lessons,
            [lessonId]: { ...getLesson(), primaryPhase: phase as typeof PHASES[number] },
          },
        }));
      });
    });

    phaseNav?.querySelectorAll<HTMLButtonElement>('[data-phase-complete]').forEach((button) => {
      button.addEventListener('click', () => {
        const phase = button.dataset.phaseComplete;
        if (phase && PHASES.includes(phase as typeof PHASES[number])) completePhase(phase as typeof PHASES[number]);
      });
    });

    markLessonButton?.addEventListener('click', () => {
      updateProgress((progress) => ({
        ...progress,
        primaryPhase: 'review',
        completedLessons: Array.from(new Set([...progress.completedLessons, lessonId])),
        lessons: {
          ...progress.lessons,
          [lessonId]: { primaryPhase: 'review', completedPhases: [...PHASES] },
        },
      }));
      setStatus('Lesson marked complete.');
      render();
    });

    resetButton?.addEventListener('click', () => {
      resetProgress();
      setStatus('Saved progress reset.');
      render();
    });

    render();
  }
</script>

<style>
  .next-step {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    margin-top: 2rem;
    padding: 1.25rem 1.4rem;
    border: 1px solid var(--lime);
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--lime) 14%, var(--surface));
  }

  .next-step .eyebrow {
    margin-bottom: 0.35rem;
  }

  .next-step-message {
    margin: 0;
    font-weight: 600;
  }

  .next-step .button {
    flex-shrink: 0;
  }

  @media (max-width: 620px) {
    .next-step {
      align-items: start;
      flex-direction: column;
    }
  }
</style>
